# Copia este archivo como .env y llena los valores.
# El archivo .env NUNCA se sube a GitHub.

# Base de datos
POSTGRES_USER=enlaceseguro
POSTGRES_PASSWORD=cambia_esta_contrasena
POSTGRES_DB=enlaceseguro

# Firma de los tokens JWT: minimo 32 caracteres aleatorios.
# Generalo con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Llaves de las fuentes de amenazas (semana 3)
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
URLHAUS_AUTH_KEY=
